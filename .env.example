# ===========================================
# KARMIO Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# --- Public (exposed to browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Karmio
# --- Private (server-only) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
RESEND_API_KEY=re_your-key
CRON_SECRET=your-random-secret-for-cron-jobs
# ^ Required for Vercel Cron. Add to Vercel project env vars.
# Cron runs every 2 hours (0 */2 * * *) via /api/jobs/cron
# Each run fetches seed companies + discovers new ones by department rotation.
# Set this in Vercel Dashboard > Settings > Environment Variables

# Comma-separated admin emails with access to /api/admin
ADMIN_EMAILS=you@example.com

# --- Optional ---
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXX
# EMERGENT_LLM_KEY=   # Fallback LLM key if using Emergent API
